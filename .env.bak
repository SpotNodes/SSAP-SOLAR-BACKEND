NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Requires a replica set for multi-document transactions (see docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/ssap_solar?replicaSet=rs0

JWT_ACCESS_SECRET=a9b7e5be375a379ced700b8baa315f1d9307af846efd7638ebfc703fe898ced0
JWT_REFRESH_SECRET=7accbebf956ab55bac6793bdef558a1c3df5e3b152b793e1be855a47aeb20dd4
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list of browser origins allowed by CORS (admin dashboard + website)
ADMIN_ORIGIN=http://localhost:5173

# First admin account, created by `npm run seed`
ADMIN_BOOTSTRAP_EMAIL=admin@ssapsolar.com
ADMIN_BOOTSTRAP_PASSWORD=SsapSolar@2026
ADMIN_NOTIFICATION_EMAIL=admin@ssapsolar.com

# Pluggable providers — "dev" stubs log to console; swap when real credentials arrive
OTP_PROVIDER=dev
# Demo convenience: pins every OTP to this code so testers don't read the log each time.
# Ignored unless OTP_PROVIDER=dev and NODE_ENV != production. Unset for random codes.
DEV_FIXED_OTP=123456
PUSH_PROVIDER=dev
EMAIL_PROVIDER=dev
STORAGE_PROVIDER=dev

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
