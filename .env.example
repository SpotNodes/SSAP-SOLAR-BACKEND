NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Requires a replica set for multi-document transactions (see docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/ssap_solar?replicaSet=rs0

JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list of browser origins allowed by CORS (admin dashboard + website)
ADMIN_ORIGIN=http://localhost:5173

# First admin account, created by `npm run seed`
ADMIN_BOOTSTRAP_EMAIL=admin@ssapsolar.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password

# Pluggable providers — "dev" stubs log to console; swap when real credentials arrive
OTP_PROVIDER=dev
PUSH_PROVIDER=dev
EMAIL_PROVIDER=dev
STORAGE_PROVIDER=dev

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
